# Copy to backend/.env only for values that are not already in the process environment.
# Existing OPENAI_API_KEY and GROQ_API_KEY are picked up automatically.
# Do not commit real keys.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank to use GROQ_API_KEY for chat when it is already set.
# Set LLM_PROVIDER=openai to use OPENAI_API_KEY instead.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

WEATHER_API_PROVIDER=open-meteo
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Set this before an internal deployment. Requests then require header X-Internal-Token.
INTERNAL_API_TOKEN=

# Operational alert heuristics. These are not calibrated disease models.
ALERT_HEAVY_RAIN_MM=50
ALERT_HEAVY_RAIN_PROBABILITY=80
ALERT_HEAVY_RAIN_MIN_MM_WITH_PROBABILITY=20
ALERT_EXTREME_HEAT_C=40
ALERT_EXTREME_COLD_C=5
ALERT_HIGH_HUMIDITY=85
ALERT_LOW_SOIL_MOISTURE=30
ALERT_HUMIDITY_CROPS=rice,paddy,tomato,potato,cotton,grape
ALERT_DEDUPE_HOURS=12
WEATHER_CACHE_SECONDS=600
